{
  "name": "dsh-card-lan",
  "version": "0.5.4",
  "private": true,
  "description": "局域网牌桌：21 点 / 斗地主 / 跑得快，UDP 房间发现 + 房主权威牌局，支持密码/观战/掉线重连。",
  "icon": "icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/engine.js",
    "lib/games/doudizhu.js",
    "lib/games/paodekuai.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/",
    "check": "node --check lib/index.js && node --check lib/engine.js && node --check lib/games/doudizhu.js && node --check lib/games/paodekuai.js && node --check client.js"
  },
  "license": "MIT",
  "author": "Fatelikeshit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fatelikeshit/dsh-card-lan.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "lan",
    "blackjack",
    "doudizhu",
    "paodekuai",
    "multiplayer"
  ]
}
